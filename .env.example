APP_NAME="LPPM Universitas Lampung"
APP_ENV=production
APP_KEY=base64:test123456789012345678901234567890123456789012345678901234567890
APP_DEBUG=false
APP_URL=https://lppm.unila.ac.id

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database Configuration (sama dengan WordPress)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teslppm_2022
DB_USERNAME=teslppm_2022
DB_PASSWORD=satriamadangkar4

# WordPress Connection (untuk akses tabel WordPress)
WP_DB_CONNECTION=wordpress
DB_WP_HOST=127.0.0.1
DB_WP_PORT=3306
DB_WP_DATABASE=teslppm_2022
DB_WP_USERNAME=teslppm_2022
DB_WP_PASSWORD=satriamadangkar4
DB_WP_PREFIX=2022_

# WordPress Base URL
WP_BASE_URL=https://lppm.unila.ac.id

# Aktifkan hanya setelah zona waktu CMS dan Cron Job hosting sudah lulus UAT.
CMS_SCHEDULING_ENABLED=false

# API URL untuk frontend
VITE_LARAVEL_API_URL=https://lppm.unila.ac.id/api

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache Configuration
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

CORS_ALLOWED_ORIGINS=https://lppm.unila.ac.id
